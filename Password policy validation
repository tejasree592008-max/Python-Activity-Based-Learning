password = input("Enter your password: ")

uppercase = False
lowercase = False
digit = False
special = False

for ch in password:
    if ch.isupper():
        uppercase = True
    elif ch.islower():
        lowercase = True
    elif ch.isdigit():
        digit = True
    else:
        special = True

if (len(password) >= 8 and uppercase and lowercase
        and digit and special):
    print("Valid Password")
else:
    print("Invalid Password")
